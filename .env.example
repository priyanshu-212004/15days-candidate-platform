# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fifteendays?schema=public"

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string  # `openssl rand -base64 32`

# OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (password reset, invites) — leave EMAIL_PROVIDER blank to log instead
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=            # "resend"
EMAIL_FROM=noreply@15days.io
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Object storage (video responses, resumes) — any S3-compatible provider:
# AWS S3, Cloudflare R2, Supabase Storage, MinIO. The client always uses
# path-style addressing (forcePathStyle), which every one of these accepts —
# switching provider is a pure env change, no code change.
# For Supabase specifically: STORAGE_ENDPOINT is your project's S3 endpoint,
# e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=                         # required for R2 / Supabase / non-AWS S3
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=                  # optional CDN/public base for reads

# ---------------------------------------------------------------------------
# Redis / background jobs (BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AI providers — question generation + resume/answer evaluation both read
# this. Switching providers is an env change only; no code change needed.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai                        # "openai" | "anthropic" | "gemini"
AI_MODEL=                                 # optional override; sensible default per provider if blank
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Speech-to-text (transcribes candidate video answers before AI evaluation).
# Reuses OPENAI_API_KEY / GEMINI_API_KEY above — no separate key needed if
# AI_PROVIDER is already "openai" or "gemini". Leave blank to fall back to
# AI_PROVIDER automatically (when it's "openai" or "gemini"). Anthropic
# cannot transcribe audio (Claude has no audio input), and "assemblyai" is
# not implemented (its API is async/poll-based, which doesn't fit this
# project's no-job-queue architecture) — either currently fails clearly
# rather than pretending to work.
STT_PROVIDER=openai                       # "openai" (Whisper) | "gemini"
STT_MODEL=                                # optional override; defaults to whisper-1 / gemini-2.0-flash
ASSEMBLYAI_API_KEY=                       # reserved, not currently used — see comment above

# ---------------------------------------------------------------------------
# Integrations (optional)
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GREENHOUSE_API_KEY=
LEVER_API_KEY=
